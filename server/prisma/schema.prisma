generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PUBLISHER
  STUDENT
  FACULTY
  ADMIN
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(STUDENT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  publisher    PublisherProfile?
  student      Student?
  faculty      Faculty?

  publishedProblems Problem[]      @relation("PublisherProblems")
  notifications     Notification[]
}

model PublisherProfile {
  id                      String   @id @default(cuid())
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String   @unique
  organizationName        String   @default("Government / Industry Organization")
  organizationType        String   @default("Government Department")
  designation             String?  @default("Innovation Officer")
  location                String   @default("National")
  city                    String?  @default("Coimbatore")
  district                String?  @default("Coimbatore District")
  state                   String?  @default("Tamil Nadu")
  country                 String?  @default("India")
  workingDomains          String[] @default(["DISASTER_MANAGEMENT", "WATER_MANAGEMENT"])
  organizationDescription String?  @default("Authorized public authority managing regional infrastructure and open societal innovation challenges.")
  website                 String?  @default("https://solink.ai")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt
}

model University {
  id        String    @id @default(cuid())
  name      String
  location  String
  createdAt DateTime  @default(now())

  faculty   Faculty[]
  students  Student[]
  matches   Match[]
  problems  Problem[] @relation("RoutedProblems")
}

model Faculty {
  id                      String         @id @default(cuid())
  name                    String
  role                    String         @default("Faculty Mentor")
  universityName          String?        @default("Anna Institute of Technology")
  department              String         @default("Computer Science & Engineering")
  designation             String?        @default("Professor")
  location                String?        @default("Coimbatore, TN")
  primaryResearchDomain   String?        @default("DISASTER_MANAGEMENT")
  secondaryResearchDomains String[]      @default(["WATER_MANAGEMENT", "ENVIRONMENT"])
  researchAreas           String[]       @default(["IoT Flood Early Warning", "Sensor Networks", "Climate Analytics"])
  expertise               String[]       @default(["Disaster Management", "IoT", "Machine Learning"])
  skills                  String[]       @default(["Machine Learning", "IoT", "Data Analytics"])
  bio                     String?        @default("Passionate professor researching AI/IoT applications for disaster management and civic resilience.")
  university              University?    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  universityId            String?

  user                    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                  String?        @unique
  projects                MentorProject[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @default(now()) @updatedAt
}

model Student {
  id               String           @id @default(cuid())
  name             String
  universityName   String?          @default("Anna Institute of Technology")
  department       String           @default("Computer Science & Engineering")
  yearOfStudy      String?          @default("3rd Year B.Tech")
  location         String?          @default("Coimbatore, TN")
  primaryDomain    String?          @default("DISASTER_MANAGEMENT")
  secondaryDomains String[]         @default(["WATER_MANAGEMENT", "TECHNOLOGY"])
  skills           String[]         @default(["Machine Learning", "Python", "IoT"])
  interests        String[]         @default(["Disaster Management", "Machine Learning", "IoT Sensors"])
  bio              String?          @default("Student developer focused on building smart city IoT applications and early flood warning platforms.")
  university       University?      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  universityId     String?

  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId           String?          @unique
  projects         StudentProject[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
}

model StudentProject {
  id             String   @id @default(cuid())
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String
  title          String
  description    String
  domain         String   @default("DISASTER_MANAGEMENT")
  technologies   String[] @default([])
  completionYear String   @default("2025")
  projectUrl     String?
  createdAt      DateTime @default(now())
}

model MentorProject {
  id             String   @id @default(cuid())
  faculty        Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  facultyId      String
  title          String
  description    String
  domain         String   @default("DISASTER_MANAGEMENT")
  technologies   String[] @default([])
  completionYear String   @default("2024")
  projectUrl     String?
  createdAt      DateTime @default(now())
}

enum ProblemStatus {
  SUBMITTED
  ANALYZING
  ANALYZED
  MATCHED
  ROUTED
  IN_PROGRESS
  DONE
}

model Problem {
  id                  String        @id @default(cuid())
  title               String        @default("Untitled Challenge")
  org                 String
  location            String        @default("National")
  description         String
  domain              String        @default("OTHER")
  suggestedDomain     String?
  primaryDomain       String?
  aiSummary           String?
  aiConfidence        Float?
  aiRequiredExpertise String[]      @default([])
  extractedTags       String[]      @default([])
  status              ProblemStatus @default(SUBMITTED)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  publisher           User?         @relation("PublisherProblems", fields: [publisherId], references: [id], onDelete: SetNull)
  publisherId         String?

  routedTo            University?   @relation("RoutedProblems", fields: [routedToId], references: [id])
  routedToId          String?

  matches             Match[]
  tasks               Task[]
  notifications       Notification[]
}

model Match {
  id           String     @id @default(cuid())
  problem      Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId    String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  universityId String
  score        Int
  breakdown    Json?
  createdAt    DateTime   @default(now())

  @@unique([problemId, universityId])
}

enum TaskColumn {
  TODO
  DOING
  DONE
}

model Task {
  id        String     @id @default(cuid())
  problem   Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId String
  title     String
  column    TaskColumn @default(TODO)
  createdAt DateTime   @default(now())
}

enum NotificationType {
  NEW_RELEVANT_PROBLEM
  PROBLEM_ANALYZED
  PROBLEM_STATUS_UPDATED
  SYSTEM
}

model Notification {
  id               String           @id @default(cuid())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  type             NotificationType @default(NEW_RELEVANT_PROBLEM)
  title            String
  message          String
  relatedProblem   Problem?         @relation(fields: [relatedProblemId], references: [id], onDelete: SetNull)
  relatedProblemId String?
  isRead           Boolean          @default(false)
  createdAt        DateTime         @default(now())
}
